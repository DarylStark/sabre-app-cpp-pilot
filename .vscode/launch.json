{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Pilot - Debug with test project (default UI)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/dbg-all-with_tests/src/pilot/sabre_pilot",
            "args": [
                "${workspaceFolder}/test_projects/test_project.toml"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/dbg-all-with_tests/src/pilot",
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: build",
            "miDebuggerPath": "/usr/bin/gdb",
        },
        {
            "name": "Pilot - Debug with test project (ImGUI UI)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/dbg-all-with_tests/src/pilot/sabre_pilot",
            "args": [
                "${workspaceFolder}/test_projects/test_project.toml",
                "--ui-lib",
                "../pilot_ui_imgui/libsabre_pilot_ui_imgui.so"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/dbg-all-with_tests/src/pilot",
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: build",
            "miDebuggerPath": "/usr/bin/gdb",
        },
        {
            "name": "Pilot Runner - Debug with Example App",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/dbg-all-with_tests/src/pilot_runner/sabre_pilot_runner",
            "args": [
                "${workspaceFolder}/build/dbg-all-with_tests/src/app_example_app/libapp_example_app.so",
                "startDev1"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/dbg-all-with_tests/src/pilot_runner",
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: build",
            "miDebuggerPath": "/usr/bin/gdb",
        }
    ]
}