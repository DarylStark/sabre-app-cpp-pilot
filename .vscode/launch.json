{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Pilot - Debug with test project (default UI)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/dbg-all-with_tests/src/pilot/app/sabre_pilot",
            "args": [
                "${workspaceFolder}/test_projects/test_project.toml"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/dbg-all-with_tests/src/pilot/app/",
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: build",
            "miDebuggerPath": "/usr/bin/gdb",
        },
        {
            "name": "Pilot - Debug with test project (ImGUI UI)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/dbg-all-with_tests/src/pilot/app/sabre_pilot",
            "args": [
                "${workspaceFolder}/test_projects/test_project.toml",
                "--ui-lib",
                "../ui_imgui/libsabre_pilot_ui_imgui.so"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/dbg-all-with_tests/src/pilot/app/",
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: build",
            "miDebuggerPath": "/usr/bin/gdb",
        },
        {
            "name": "Pilot Runner - Debug with example app (no IPC)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/dbg-all-with_tests/src/runner/app/sabre_pilot_runner",
            "args": [
                "${workspaceFolder}/build/dbg-all-with_tests/src/examples/example_app/libexample_app.so",
                "--ipc-id",
                "9999",
                "--ipc-mode",
                "none",
                "--sw-firmware-entry-point",
                "startDev1",
                "--hw-upperbound-uart",
                "3"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/dbg-all-with_tests/src/runner/app/",
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: build",
            "miDebuggerPath": "/usr/bin/gdb",
        },
        {
            "name": "Pilot Runner - Debug with example app (TCP IPC)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/dbg-all-with_tests/src/runner/app/sabre_pilot_runner",
            "args": [
                "${workspaceFolder}/build/dbg-all-with_tests/src/examples/example_app/libexample_app.so",
                "--ipc-id",
                "1",
                "--ipc-mode",
                "tcp",
                "--sw-firmware-entry-point",
                "startDev1",
                "--hw-upperbound-uart",
                "3"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/dbg-all-with_tests/src/runner/app/",
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: build",
            "miDebuggerPath": "/usr/bin/gdb",
        }
    ]
}