{
    "version": 4,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20
    },
    "configurePresets": [
        {
            "name": "dbg-all-with_tests",
            "displayName": "Debug - All - With tests",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/dbg-all-with_tests",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "SABRE_PILOT_BUILD_PILOT_EXEC": "ON",
                "SABRE_PILOT_BUILD_UI_LIBRARIES": "ON",
                "SABRE_PILOT_BUILD_EXAMPLE_APPS": "ON",
                "SABRE_PILOT_BUILD_TESTS": "ON",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.conan/build/Debug/generators/conan_toolchain.cmake"
            }
        },
        {
            "name": "rel-all-with_tests",
            "displayName": "Release - All - With tests",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/rel-all-with_tests",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "SABRE_PILOT_BUILD_PILOT_EXEC": "ON",
                "SABRE_PILOT_BUILD_UI_LIBRARIES": "ON",
                "SABRE_PILOT_BUILD_EXAMPLE_APPS": "ON",
                "SABRE_PILOT_BUILD_TESTS": "ON",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.conan/build/Release/generators/conan_toolchain.cmake"
            }
        },
        {
            "name": "rel-pilot_core_impl-with_tests",
            "displayName": "Release - Pilot, Core and Implementation - With tests",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/rel-pilot_core_impl-with_tests",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "SABRE_PILOT_BUILD_PILOT_EXEC": "ON",
                "SABRE_PILOT_BUILD_UI_LIBRARIES": "OFF",
                "SABRE_PILOT_BUILD_EXAMPLE_APPS": "OFF",
                "SABRE_PILOT_BUILD_TESTS": "ON",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.conan/build/Release/generators/conan_toolchain.cmake"
            }
        },
        {
            "name": "rel-core_impl-with_tests",
            "displayName": "Release - Core and Implementation - With tests",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/rel-core_impl-with_tests",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "SABRE_PILOT_BUILD_PILOT_EXEC": "OFF",
                "SABRE_PILOT_BUILD_UI_LIBRARIES": "OFF",
                "SABRE_PILOT_BUILD_EXAMPLE_APPS": "OFF",
                "SABRE_PILOT_BUILD_TESTS": "ON",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.conan/build/Release/generators/conan_toolchain.cmake"
            }
        }
    ]
}