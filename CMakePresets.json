{
    "version": 4,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20
    },
    "configurePresets": [
        {
            "name": "dbg-sabre-pilot-tests",
            "displayName": "Debug - Sabre, Tests",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/dbg-sabre-pilot-tests",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "SABRE_PILOT_BUILD_TESTS": "ON",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.conan/build/Debug/generators/conan_toolchain.cmake"
            }
        },
        {
            "name": "rel-sabre-pilot-tests",
            "displayName": "Release - Sabre, Tests",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/rel-sabre-pilot-tests",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "SABRE_PILOT_BUILD_TESTS": "ON",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.conan/build/Release/generators/conan_toolchain.cmake"
            }
        },
        {
            "name": "rel-sabre-pilot",
            "displayName": "Release - Sabre",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/rel-sabre-pilot",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "SABRE_PILOT_BUILD_TESTS": "OFF",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.conan/build/Release/generators/conan_toolchain.cmake"
            }
        }
    ]
}